public class DutchNNF_CountingMeth {
    public static void main(String[] args) {
        int[] arr = {2, 0, 2, 1, 1, 0};

        int zero = 0;
        int one = 0;
        int two = 0;

      
        for (int num : arr) {
            if (num == 0)
                zero++;
            else if (num == 1)
                one++;
            else
                two++;
        }

        int index = 0;

        while (one > 0) {
            arr[index] = 0; // OR arr[index++] = 0
            one--;
            index++;
        }

        while (one > 0) {
            arr[index] = 1;
            one--;
            index++;
        }

        while (two > 0) {
            arr[index] = 2;
            two--;
            index++;
        }

     
        for (int num : arr) {
            System.out.print(num + " ");
        }
    }
}